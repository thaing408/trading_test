# Copy via scripts/install.ps1 or scripts/install.sh (recommended),
# or copy this file to .env and fill in values.

# --- Discord delivery (pick one path) ---
# A) Webhook (optional — takes precedence over bot channel)
DISCORD_WEBHOOK_URL=

# B) Bot channel delivery
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=1510184298442002502

# C) Safe local mode (no posts) — set by install wizard dry_run / no_discord
# TRADING_AGENT_DRY_RUN=1
# TRADING_AGENT_NO_DISCORD=1

# Optional alternate env file (e.g. shared secrets file on your machine)
# TRADING_AGENT_ENV_FILE=

# Financial Modeling Prep — real economic calendar + stock news in live bias (optional)
# FMP_API_KEY=

# Market data for TR strength gates + technicals
# auto (default) = IBKR (if IBKR_ENABLED) → Schwab token → yfinance
# TRADING_AGENT_MARKET_DATA=auto|ibkr|schwab|yfinance
# SCHWAB_TOKEN_PATH=~/.schwab-mcp/token.json

# IBKR research-only OHLCV (TWS/Gateway API; never used for order placement here)
# pip install ib_insync
# IBKR_ENABLED=1
# IBKR_HOST=127.0.0.1
# IBKR_PORT=7496
# IBKR_CLIENT_ID=17
# IBKR_READONLY=1

# Required for scheduled tasks (avoid WindowsApps python shim)
# Set automatically by install.ps1 / install.sh
TRADING_AGENT_PYTHON=

# Stop after this phase:
#   evening_scan = full day (default) — close reviews + 18:00 ET swing/multi-method
#   cio_review   = stop after CIO daily review (no 6pm scanners)
#   preopen      = prep only (phases 1-4, no desk)
TRADING_AGENT_UNTIL_PHASE=evening_scan
TRADING_AGENT_FROM_PHASE=intelligence
# Light discovery rescreens at 07:00 / 09:30 / 11:00 PT during RTH
TRADING_AGENT_DISCOVERY_REFRESH=1
# Desk scanners: swing + multi-method at research (05:00 PT) and evening (18:00 ET)
TRADING_AGENT_DESK_SCANNERS=1
TRADING_AGENT_EVENING_SCAN=1
TRADING_AGENT_DESK_MULTI_METHOD=1
TRADING_AGENT_DESK_SCANNER_LIMIT=20

# Liquid mid-price exception (sub-$20 with huge ADV, e.g. LCID) — off by default
# TRADING_AGENT_LIQUID_MID_PRICE=1
# TRADING_AGENT_RISK_PROFILE=liquid_mid
# TRADING_AGENT_LIQUID_MID_MIN_PRICE=5
# TRADING_AGENT_MIN_PRICE=20

# Always start from intelligence on scheduled/catch-up runs (recommended)
TRADING_AGENT_FROM_PHASE=intelligence

# Desk timezone
TRADING_AGENT_TIMEZONE=America/Los_Angeles

# CIO portfolio sizing
TRADING_AGENT_PORTFOLIO_VALUE=100000

# Options debit only — block auto share lots (default on)
TRADING_AGENT_OPTIONS_ONLY=1
