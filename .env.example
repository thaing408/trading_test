# Discord webhook (optional — takes precedence over bot channel)
DISCORD_WEBHOOK_URL=

# Bot channel delivery (shared with researcher project)
# DISCORD_TOKEN is read from C:\Personal\Scripts\researcher\.env if not set here
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=1510184298442002502

# Override env file search path
# TRADING_AGENT_ENV_FILE=C:\Personal\Scripts\researcher\.env

# Optional: explicit Python for scheduled task runs
# TRADING_AGENT_PYTHON=C:\Users\Admin\AppData\Local\Python\bin\python.exe