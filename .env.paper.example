# trading_test — no-CIO desk + IBKR paper trading
# Copy to: ~/.trading_test/trading-test.env  (or trading_test/.env)

# --- Paths (isolated from production trading_agent) ---
TRADING_AGENT_PYTHON=/Users/thai/trading_test/.venv/bin/python
TRADING_AGENT_ENV_FILE=/Users/thai/.trading_test/trading-test.env
TRADING_AGENT_SYNC_DIR=/Users/thai/.trading_test/sync
TRADING_AGENT_POSITIONS_FILE=/Users/thai/.trading_test/positions.json
TRADING_AGENT_TIMEZONE=America/Los_Angeles

# --- No CIO ---
TRADING_AGENT_INCLUDE_CIO=0
TRADING_AGENT_NO_CIO=1
TRADING_AGENT_AUTO_EXPORT_WITHOUT_CIO=1
# Optional: skip mid-session discovery CIO promotion (already gated by INCLUDE_CIO)
TRADING_AGENT_DISCOVERY_REFRESH=1

# --- IBKR paper (TWS API socket) ---
IBKR_ENABLED=1
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=17
IBKR_TRADE_CLIENT_ID=27
# MUST be 0 to place paper orders (TWS still can force Read-Only API off for paper)
IBKR_READONLY=0
TRADING_AGENT_MARKET_DATA=auto
TRADING_AGENT_BROKER=ibkr

# --- Consumer: paper live after dry checks ---
# Day-of: set LIVE=1 only when ready to send paper orders
TRADING_AGENT_AUTO_TRADE_LIVE=0
TRADING_AGENT_AUTO_TRADE_WATCH=1

# Discord — paper activity + EOD P/L journal → #ibkr-tradings
DISCORD_IBKR_CHANNEL_ID=1536602374502613013
DISCORD_PAPER_CHANNEL_ID=1536602374502613013
DISCORD_PAPER_CHANNEL_ID=1536602374502613013
DISCORD_CHANNEL_ID=1536602374502613013
DISCORD_DESK_CHANNEL_ID=1536602374502613013
# Token: load DISCORD_BOT_TOKEN from ~/.grok/discord.env at runtime
TRADING_AGENT_NO_DISCORD=0
TRADING_AGENT_OPTIONS_ONLY=1
