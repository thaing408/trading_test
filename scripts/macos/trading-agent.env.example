# Copy to ~/.grok/trading-agent.env after Grok Discord bridge is configured

TRADING_AGENT_PYTHON=$HOME/trading_agent/.venv/bin/python
TRADING_AGENT_ENV_FILE=$HOME/.grok/trading-agent.env
TRADING_AGENT_TIMEZONE=America/Los_Angeles
TRADING_AGENT_POSITIONS_FILE=$HOME/.trading_agent/positions.json

# Full day by default (launchd desk auto-pulls code — no manual daily prepare)
TRADING_AGENT_UNTIL_PHASE=cio_review
TRADING_AGENT_DISCOVERY_REFRESH=1
# Prep-only (optional): TRADING_AGENT_UNTIL_PHASE=preopen

# Desk Discord channel (#daily-plays) — separate from scalp-pulse / trading-journal
DISCORD_DESK_CHANNEL_ID=1510184298442002502

# --- Mac auto-trade (local books only; never work file sync) ---
# Fail-closed: keep LIVE=0 for ready_orders + checklist only
TRADING_AGENT_AUTO_TRADE_LIVE=0
TRADING_AGENT_AUTO_TRADE_POLL=60
# Optional: process books outside 9:25–11:00 ET (debug)
# TRADING_AGENT_AUTO_TRADE_ANYTIME=0
# QT open-window symbols (space-separated)
TRADING_AGENT_QT_SYMBOLS=QQQ SPY IWM
TRADING_AGENT_QT_POLL=60
# Schwab MCP (home Mac only)
# SCHWAB_MCP_PYTHON=$HOME/schwab-mcp-server/.venv/bin/python

# --- Research cash posture A/B (tiny loosen; keeps A-prefer + full gates) ---
# 1 = conf 55 + B-exception quality 65 (and CIO conf 55 unless CIO override set)
# 0 or unset = shipped defaults (conf 60, B quality 70)
TRADING_AGENT_SLIGHT_LESS_CASH=1
# Optional fine knobs (override preset when set):
# TRADING_AGENT_MIN_CONFIDENCE=55
# TRADING_AGENT_MIN_QUALITY_B_EXCEPTION=65
# TRADING_AGENT_CIO_MIN_CONFIDENCE=55
# TRADING_AGENT_PREFER_A_TIER_ONLY=1

# Liquid mid-price: $5–$20 names with huge ADV (e.g. LCID) past $20 floor
# Keeps global min_price=$20; only liquid names get the exception
TRADING_AGENT_LIQUID_MID_PRICE=1
TRADING_AGENT_RISK_PROFILE=liquid_mid
# TRADING_AGENT_LIQUID_MID_MIN_PRICE=5
# TRADING_AGENT_LIQUID_MID_MIN_ADV=5000000


# Auto bot merges Discord pulse gainers/losers into scan universe
# Gainers preferred; TOP_DOWN low — blanketing losers with PUTs lost on 7/15–17
AUTO_TRADE_INCLUDE_MOVERS=1
AUTO_TRADE_MOVERS_TOP_UP=4
AUTO_TRADE_MOVERS_TOP_DOWN=1
# AUTO_TRADE_MAX_SCAN_SYMBOLS=16
# Entry policy for mover-tagged names (defaults match production)
# AUTO_TRADE_MOVERS_GAINER_CALLS_ONLY=1   # gainer → CALL/pullback only
# AUTO_TRADE_MOVERS_ALLOW_LOSER_PUTS=1    # 0 = never short losers
# AUTO_TRADE_MOVERS_SKIP_BOTH=1          # skip gainer↔loser flips
# AUTO_TRADE_MOVERS_SKIP_VOL_ETFS=1       # no UVXY/SQQQ/TQQQ as loser shorts
# AUTO_TRADE_MOVERS_LOSER_MIN_PCT=3.0     # need ≤ -3% for loser PUT
# AUTO_TRADE_MOVERS_MAX_LOSER_ENTRIES=1   # max loser-origin entries/day
