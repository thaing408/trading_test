# Copy to ~/.grok/trading-agent.env after Grok Discord bridge is configured

TRADING_AGENT_PYTHON=$HOME/trading_agent/.venv/bin/python
TRADING_AGENT_ENV_FILE=$HOME/.grok/trading-agent.env
TRADING_AGENT_TIMEZONE=America/Los_Angeles
TRADING_AGENT_POSITIONS_FILE=$HOME/.trading_agent/positions.json

# Full day by default (launchd desk auto-pulls code — no manual daily prepare)
TRADING_AGENT_UNTIL_PHASE=cio_review
TRADING_AGENT_DISCOVERY_REFRESH=1
# Prep-only (optional): TRADING_AGENT_UNTIL_PHASE=preopen

# Desk Discord channel (#daily-plays) — separate from scalp-pulse / trading-journal
DISCORD_DESK_CHANNEL_ID=1510184298442002502
