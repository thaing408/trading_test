<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.grok.me-ai-vnc-tunnel</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__REPO__/scripts/macos/me-ai-vnc-tunnel.sh</string>
		<string>--loop</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
		<key>ME_AI_SSH_USER</key>
		<string>ubuntu</string>
		<key>ME_AI_VNC_LOCAL_PORT</key>
		<string>5901</string>
		<key>ME_AI_VNC_REMOTE_PORT</key>
		<string>5900</string>
	</dict>
	<key>StandardOutPath</key>
	<string>__HOME__/.trading_test/logs/launchd-me-ai-vnc-tunnel.out.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.trading_test/logs/launchd-me-ai-vnc-tunnel.err.log</string>
</dict>
</plist>
